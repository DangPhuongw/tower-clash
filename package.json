{
  "name": "tower-clash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,green \"pnpm --filter @tower-clash/client dev\" \"pnpm --filter @tower-clash/server dev\"",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.21.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  }
}
